---
import Container from '@/components/common/Container.astro';
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="プライバシーポリシー"
  description="テックログにおけるアクセス解析と問い合わせ情報の取り扱いを説明します。"
  pageClass="static-page"
>
  <Container class="privacy">
    <header><p>PRIVACY</p><h1>プライバシーポリシー</h1><p>最終更新日: 2026年7月11日</p></header>
    <section>
      <h2>アクセス解析</h2><p>
        本サイトは、利用状況を把握して改善するためCloudflare Web
        Analyticsを使用する場合があります。Cloudflareが処理する情報については、Cloudflareのプライバシーに関する説明をご確認ください。
      </p>
    </section>
    <section>
      <h2>Cookie、広告、データベース</h2><p>
        本サイトは、独自のCookie、行動ターゲティング広告、閲覧者を追跡するためのデータベースを使用しません。
      </p>
    </section>
    <section>
      <h2>問い合わせ</h2><p>
        問い合わせにmailtoリンクを使用する場合、メールアドレス、本文などは利用者が選んだメールサービスを通じて送信されます。受信した情報は返信と必要な連絡のためにのみ使用します。
      </p>{
        SITE.email && (
          <p>
            <a href={`mailto:${SITE.email}`}>メールで問い合わせる</a>
          </p>
        )
      }
    </section>
    <section><h2>変更</h2><p>利用サービスや運用方法を変更した場合、このページを更新します。</p></section>
  </Container>
</BaseLayout>

<style>
  .privacy {
    max-inline-size: 52rem;
    padding-block: clamp(var(--space-12), 8vw, var(--space-24));
  }
  header {
    padding-block-end: var(--space-10);
    border-block-end: 1px solid var(--color-border);
  }
  header > p:first-child {
    color: var(--color-accent-soft);
    font-family: var(--font-mono);
    letter-spacing: 0.18em;
  }
  h1 {
    margin: var(--space-3) 0;
    font-size: clamp(2rem, 5vw, 3.4rem);
  }
  section {
    padding-block: var(--space-8);
    border-block-end: 1px solid var(--color-border);
  }
  h2 {
    margin-block-start: 0;
  }
  p {
    color: var(--color-text-muted);
    line-height: 1.9;
  }
</style>

---
import { getCollection } from 'astro:content';

import AuthorProfile from '@/components/home/AuthorProfile.astro';
import Hero from '@/components/home/Hero.astro';
import LatestArticles from '@/components/home/LatestArticles.astro';
import PopularTags from '@/components/home/PopularTags.astro';
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getFeaturedPost, getLatestPosts, getPublishedPosts } from '@/lib/content/posts';
import { readingMinutes } from '@/lib/content/reading-time';
import { getPopularTags, tagToHref } from '@/lib/content/tags';

const dateFormatter = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Tokyo',
});

const entries = await getCollection('blog');
const published = getPublishedPosts(entries);
const featuredEntry = getFeaturedPost(published);

if (!featuredEntry) {
  throw new Error('ホームページを表示するには公開記事が1件以上必要です');
}

const toArticleView = (entry: (typeof published)[number]) => ({
  href: `/blog/${entry.id}/`,
  title: entry.data.title,
  description: entry.data.description,
  publishedDate: entry.data.publishedAt.toISOString(),
  publishedLabel: dateFormatter.format(entry.data.publishedAt),
  category: entry.data.category,
  tags: entry.data.tags,
  readingMinutes: readingMinutes(entry.body ?? ''),
  heroImage: entry.data.heroImage,
});

const featured = {
  ...toArticleView(featuredEntry),
  featuredCode: featuredEntry.data.featuredCode,
};
const latest = getLatestPosts(published, 4).map(toArticleView);
const popularTags = getPopularTags(published, 10).map((tag) => ({ ...tag, href: tagToHref(tag.label) }));
const technologies = ['AWS', 'React', 'TypeScript', 'Terraform', 'Java', 'AI', 'Ops'] as const;
---

<BaseLayout>
  <Hero siteName={SITE.name} tagline={SITE.tagline} description={SITE.description} {technologies} {featured} />
  <LatestArticles articles={latest} />
  <PopularTags tags={popularTags} />
  <AuthorProfile name={SITE.author} />
</BaseLayout>

---
import { getCollection } from 'astro:content';

import ListingLayout from '@/layouts/ListingLayout.astro';
import { paginate } from '@/lib/content/pagination';
import { getPublishedPosts } from '@/lib/content/posts';
import { readingMinutes } from '@/lib/content/reading-time';

const PAGE_SIZE = 12;
const dateFormatter = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Tokyo',
});

const published = getPublishedPosts(await getCollection('blog'));
const pages = paginate(published, PAGE_SIZE);
const firstPage = pages[0] ?? [];
const articles = firstPage.map((entry) => ({
  href: `/blog/${entry.id}/`,
  title: entry.data.title,
  description: entry.data.description,
  publishedDate: entry.data.publishedAt.toISOString(),
  publishedLabel: dateFormatter.format(entry.data.publishedAt),
  category: entry.data.category,
  tags: entry.data.tags,
  readingMinutes: readingMinutes(entry.body ?? ''),
  heroImage: entry.data.heroImage,
}));
---

<ListingLayout
  title="記事一覧"
  description="現場で得た技術の実践知を、新しい記事から順にまとめています。"
  {articles}
  count={published.length}
  pagination={{ current: 1, total: Math.max(pages.length, 1), base: '/blog/' }}
/>

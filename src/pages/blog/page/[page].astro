---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';

import ListingLayout from '@/layouts/ListingLayout.astro';
import { paginate } from '@/lib/content/pagination';
import { getPublishedPosts } from '@/lib/content/posts';
import { readingMinutes } from '@/lib/content/reading-time';

export const getStaticPaths = (async () => {
  const pageSize = 12;
  const published = getPublishedPosts(await getCollection('blog'));
  const pages = paginate(published, pageSize);

  return pages.slice(1).map((posts, index) => ({
    params: { page: String(index + 2) },
    props: {
      posts,
      current: index + 2,
      total: pages.length,
      count: published.length,
    },
  }));
}) satisfies GetStaticPaths;

const { posts, current, total, count } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Tokyo',
});
const articles = posts.map((entry) => ({
  href: `/blog/${entry.id}/`,
  title: entry.data.title,
  description: entry.data.description,
  publishedDate: entry.data.publishedAt.toISOString(),
  publishedLabel: dateFormatter.format(entry.data.publishedAt),
  category: entry.data.category,
  tags: entry.data.tags,
  readingMinutes: readingMinutes(entry.body ?? ''),
  heroImage: entry.data.heroImage,
}));
---

<ListingLayout
  title={`記事一覧 — ${current}ページ目`}
  description="現場で得た技術の実践知を、新しい記事から順にまとめています。"
  {articles}
  {count}
  pagination={{ current, total, base: '/blog/' }}
/>

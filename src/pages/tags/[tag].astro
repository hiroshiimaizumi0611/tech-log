---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';

import ListingLayout from '@/layouts/ListingLayout.astro';
import { readingMinutes } from '@/lib/content/reading-time';
import { buildTagPages } from '@/lib/content/tags';

export const getStaticPaths = (async () => {
  const tagPages = buildTagPages(await getCollection('blog'));
  return tagPages.map((tagPage) => ({
    params: { tag: tagPage.segment },
    props: { tagPage },
  }));
}) satisfies GetStaticPaths;

const { tagPage } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Tokyo',
});
const articles = tagPage.posts.map((entry) => ({
  href: `/blog/${entry.id}/`,
  title: entry.data.title,
  description: entry.data.description,
  publishedDate: entry.data.publishedAt.toISOString(),
  publishedLabel: dateFormatter.format(entry.data.publishedAt),
  category: entry.data.category,
  tags: entry.data.tags,
  readingMinutes: readingMinutes(entry.body ?? ''),
  heroImage: entry.data.heroImage,
}));
---

<ListingLayout
  title={`${tagPage.label}の記事`}
  description={`タグ「${tagPage.label}」が付いた記事です。`}
  {articles}
  count={tagPage.count}
/>

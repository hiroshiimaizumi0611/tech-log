---
import { getCollection } from 'astro:content';

import CategoryArtwork from '@/components/blog/CategoryArtwork.astro';
import Container from '@/components/common/Container.astro';
import { CATEGORIES, CATEGORY_KEYS } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPosts } from '@/lib/content/posts';

const published = getPublishedPosts(await getCollection('blog'));
const categories = CATEGORY_KEYS.map((key) => ({
  key,
  ...CATEGORIES[key],
  count: published.filter(({ data }) => data.category === key).length,
}));
---

<BaseLayout title="カテゴリー一覧" description="6つのテーマから技術記事を探せます。">
  <Container class="index-shell">
    <header>
      <p class="eyebrow">CATEGORIES</p>
      <h1>カテゴリー一覧</h1>
      <p class="description">クラウドから運用まで、技術領域ごとに記事をまとめています。</p>
    </header>
    <nav class="category-index" data-category-index aria-label="カテゴリー別の記事">
      {
        categories.map((category) => (
          <a href={`/categories/${category.slug}/`}>
            <span class="artwork">
              <CategoryArtwork category={category.key} instanceKey={`category-index-${category.slug}`} />
            </span>
            <span class="category-copy">
              <strong>{category.label}</strong>
              <span>{category.count}件</span>
            </span>
          </a>
        ))
      }
    </nav>
  </Container>
</BaseLayout>

<style>
  :global(.index-shell) {
    padding-block: clamp(var(--space-16), 8vw, var(--space-24));
  }

  header {
    max-inline-size: 48rem;
    margin-block-end: var(--space-12);
  }

  .eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  h1 {
    margin: 0;
    font-family: var(--font-ui);
    font-size: clamp(2rem, 5vw, 3.75rem);
    letter-spacing: -0.045em;
    line-height: 1.12;
  }

  .description {
    margin: var(--space-5) 0 0;
    color: var(--color-text-muted);
  }

  .category-index {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .category-index > a {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    color: var(--color-text);
    background: var(--color-card);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast),
      background-color var(--transition-fast);
  }

  .category-index > a:hover {
    border-color: color-mix(in srgb, var(--color-accent) 46%, var(--color-border));
    color: var(--color-text);
    background: var(--color-card-hover);
    transform: translateY(-0.25rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .category-index > a:hover {
      transform: none;
    }
  }

  .artwork {
    display: block;
    aspect-ratio: 16 / 7;
    border-block-end: 1px solid var(--color-border);
  }

  .category-copy {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5);
  }

  strong {
    font-family: var(--font-ui);
  }

  .category-copy > span {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  @media (max-width: 56rem) {
    .category-index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 38rem) {
    .category-index {
      grid-template-columns: 1fr;
    }
  }
</style>

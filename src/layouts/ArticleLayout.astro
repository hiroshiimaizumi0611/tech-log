---
import ArticleMeta from '@/components/blog/ArticleMeta.astro';
import ArticleToc from '@/components/blog/ArticleToc.astro';
import RelatedArticles from '@/components/blog/RelatedArticles.astro';
import Container from '@/components/common/Container.astro';
import { SITE, type CategoryKey } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { ArticleView } from '@/lib/content/listings';
import '@/styles/article.css';
import type { ImageMetadata } from 'astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Adjacent {
  href: string;
  title: string;
}
interface Props {
  title: string;
  description: string;
  publishedDate: string;
  publishedLabel: string;
  updatedDate?: string;
  updatedLabel?: string;
  category: CategoryKey;
  tags: readonly string[];
  readingMinutes: number;
  headings: Heading[];
  previous?: Adjacent;
  next?: Adjacent;
  related: ArticleView[];
  ogImage?: string | ImageMetadata;
  heroImage?: string | ImageMetadata;
}
const {
  title,
  description,
  publishedDate,
  publishedLabel,
  updatedDate,
  updatedLabel,
  category,
  tags,
  readingMinutes,
  headings,
  previous,
  next,
  related,
  ogImage,
  heroImage,
} = Astro.props;
---

<BaseLayout
  {title}
  {description}
  pageClass="article-page"
  pageType="article"
  {ogImage}
  {heroImage}
  publishedAt={publishedDate}
  updatedAt={updatedDate}
>
  <Container class="article-shell">
    <article data-pagefind-body>
      <header class="article-header">
        <p class="article-header__eyebrow">FIELD NOTE / {category}</p>
        <h1 data-pagefind-meta="title">{title}</h1>
        <p class="article-header__description" data-pagefind-meta="description">{description}</p>
        <ArticleMeta {publishedDate} {publishedLabel} {updatedDate} {updatedLabel} {category} {tags} {readingMinutes} />
      </header>

      <ArticleToc {headings} variant="mobile" />
      <div class="article-grid">
        <div class="article-body" data-article-body><slot /></div>
        <aside><ArticleToc {headings} variant="desktop" /></aside>
      </div>
    </article>

    <nav class="adjacent" aria-label="前後の記事" data-adjacent-articles>
      <div>
        {
          previous && (
            <a href={previous.href}>
              <>
                <span>← 前の記事</span>
                <strong>{previous.title}</strong>
              </>
            </a>
          )
        }
      </div>
      <div>
        {
          next && (
            <a href={next.href}>
              <>
                <span>次の記事 →</span>
                <strong>{next.title}</strong>
              </>
            </a>
          )
        }
      </div>
    </nav>

    <section class="article-author" aria-label="著者情報" data-author>
      <span class="article-author__mark" aria-hidden="true">HI</span>
      <div><p>WRITTEN BY</p><h2>{SITE.author}</h2><p>クラウドからフロントエンドまで、実装と運用で得た知見を記録しています。</p></div>
    </section>
    <RelatedArticles articles={related} />
  </Container>
  <script>
    import '@/scripts/code-copy';
  </script>
</BaseLayout>

---
import FeaturedArticle from '@/components/blog/FeaturedArticle.astro';
import Container from '@/components/common/Container.astro';
import InteractiveHeroNetwork from '@/components/home/InteractiveHeroNetwork.astro';

interface Props {
  siteName: string;
  tagline: string;
  description: string;
  technologies: readonly string[];
  featured: {
    href: string;
    title: string;
  };
}

const { siteName, tagline, description, technologies, featured } = Astro.props;
---

<section class="hero" aria-label="サイト紹介">
  <Container class="hero-inner">
    <div class="intro" data-hero-entrance>
      <span class="kicker">TECH BLOG</span>
      <h1>{siteName}</h1>
      <p class="tagline">{tagline}</p>
      <p class="description">{description}</p>
      <div class="accent-line" aria-hidden="true"></div>
      <p class="tech-list">{technologies.join(' / ')}</p>
      <div class="abstract-mark" aria-hidden="true">
        <span>&lt;</span><span>/</span><span>&gt;</span>
      </div>
    </div>
    <InteractiveHeroNetwork />
    <div class="featured-slot" data-hero-entrance>
      <FeaturedArticle {...featured} />
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-block-end: 1px solid var(--color-border);
    background:
      radial-gradient(circle at 68% 24%, color-mix(in srgb, var(--color-accent) 7%, transparent), transparent 34%),
      color-mix(in srgb, var(--color-background) 93%, transparent);
  }

  :global(.hero-inner) {
    position: relative;
    min-block-size: clamp(34rem, 70vh, 44rem);
    padding-block: clamp(var(--space-12), 7vw, var(--space-16));
  }

  :global(.hero-inner) > * {
    min-inline-size: 0;
  }

  .intro {
    position: relative;
    z-index: 2;
    inline-size: min(47%, 38rem);
    min-inline-size: 0;
  }

  :global(.hero-inner) > :global([data-hero-network]) {
    position: absolute;
    z-index: 1;
    inset-block: clamp(var(--space-6), 5vw, var(--space-12)) var(--space-5);
    inset-inline-end: 0;
    inline-size: 64%;
    max-inline-size: none;
    opacity: 0.96;
    mask-image: linear-gradient(to right, transparent 0%, #000 18%, #000 100%);
  }

  .featured-slot {
    position: absolute;
    z-index: 3;
    inset-inline-end: clamp(var(--space-4), 4vw, var(--space-10));
    inset-block-end: clamp(var(--space-5), 4vw, var(--space-10));
    inline-size: min(31rem, 42%);
    min-inline-size: 0;
  }

  .kicker {
    color: var(--color-accent-soft);
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.32em;
  }

  h1 {
    margin: var(--space-5) 0 0;
    font-family: var(--font-ui);
    font-size: clamp(3rem, 5vw, 4.75rem);
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .tagline {
    margin: var(--space-5) 0 0;
    color: var(--color-text);
    font-family: var(--font-ui);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 650;
    letter-spacing: 0.02em;
  }

  .description {
    max-inline-size: 34rem;
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .accent-line {
    inline-size: 2.25rem;
    block-size: 2px;
    margin-block-start: var(--space-6);
    background: var(--color-accent);
  }

  .tech-list {
    margin: var(--space-6) 0 0;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: clamp(0.7rem, 1.2vw, 0.8rem);
    font-weight: 600;
    letter-spacing: 0.015em;
  }

  .abstract-mark {
    position: absolute;
    z-index: -1;
    inset-block-start: -4rem;
    inset-inline-start: -4rem;
    display: flex;
    gap: 0.15em;
    color: color-mix(in srgb, var(--color-accent) 9%, transparent);
    font-family: var(--font-mono);
    font-size: clamp(6rem, 13vw, 10rem);
    font-weight: 800;
    letter-spacing: -0.2em;
    transform: rotate(-8deg);
  }

  .intro > .kicker,
  .intro > h1,
  .intro > .tagline,
  .intro > .description,
  .intro > .accent-line,
  .intro > .tech-list {
    animation: hero-intro-enter 280ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .intro > h1 {
    animation-delay: 80ms;
  }

  .intro > .tagline {
    animation-delay: 160ms;
  }

  .intro > .description {
    animation-delay: 240ms;
  }

  .intro > .accent-line {
    animation-delay: 320ms;
  }

  .intro > .tech-list {
    animation-delay: 400ms;
  }

  .featured-slot {
    animation: hero-featured-enter 280ms 480ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes hero-intro-enter {
    from {
      opacity: 0;
      transform: translateY(0.65rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-featured-enter {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 63.99rem) {
    :global(.hero-inner) {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
      min-block-size: 0;
      padding-block: var(--space-12);
    }

    .intro,
    :global(.hero-inner) > :global([data-hero-network]) {
      position: relative;
      inset: auto;
      inline-size: 100%;
    }

    .featured-slot {
      position: static;
      inline-size: 100%;
    }

    .intro {
      max-inline-size: 38rem;
    }

    :global(.hero-inner) > :global([data-hero-network]) {
      mask-image: none;
      opacity: 0.9;
    }

    .featured-slot {
      max-inline-size: 36rem;
      margin-inline-start: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro > .kicker,
    .intro > h1,
    .intro > .tagline,
    .intro > .description,
    .intro > .accent-line,
    .intro > .tech-list,
    .featured-slot {
      animation: none;
    }
  }

  @media (max-width: 35rem) {
    :global(.hero-inner) {
      padding-block: var(--space-8);
    }

    .description {
      font-size: 0.86rem;
    }

    .tech-list {
      line-height: 1.8;
    }
  }
</style>

---
import type { ImageMetadata } from 'astro';

import ArticleCard from '@/components/blog/ArticleCard.astro';
import Container from '@/components/common/Container.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import type { CategoryKey } from '@/config/site';

interface Article {
  href: string;
  title: string;
  description: string;
  publishedDate: string;
  publishedLabel: string;
  category: CategoryKey;
  tags: readonly string[];
  readingMinutes: number;
  heroImage?: ImageMetadata;
}

interface Props {
  articles: readonly Article[];
}

const { articles } = Astro.props;
---

<section class="latest" aria-label="最新の記事">
  <Container>
    <SectionHeading title="最新の記事" actionLabel="すべての記事を見る" actionHref="/blog/" />
    <div class="article-grid">
      {articles.map((article) => <ArticleCard {...article} />)}
    </div>
  </Container>
</section>

<style>
  .latest {
    padding-block: clamp(var(--space-16), 8vw, var(--space-24));
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
  }

  @media (max-width: 70rem) {
    .article-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 38rem) {
    .article-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>

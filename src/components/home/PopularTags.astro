---
import Container from '@/components/common/Container.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import TagChip from '@/components/common/TagChip.astro';

interface Tag {
  label: string;
  count: number;
  href: string;
}

interface Props {
  tags: readonly Tag[];
}

const { tags } = Astro.props;
---

<section class="popular-tags" aria-label="人気のタグ">
  <Container class="popular-tags__inner">
    <SectionHeading title="人気のタグ" />
    <div class="tag-list">
      {tags.slice(0, 10).map((tag) => <TagChip {...tag} />)}
    </div>
  </Container>
</section>

<style>
  .popular-tags {
    padding-block: var(--space-6);
    border-block: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-section) 72%, transparent);
  }

  :global(.popular-tags__inner) {
    display: flex;
    gap: var(--space-8);
    align-items: center;
  }

  :global(.popular-tags__inner .section-heading) {
    flex: 0 0 auto;
    margin-block-end: 0;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 70.01rem) {
    .tag-list {
      column-gap: var(--space-2);
    }
  }

  .tag-list :global(.tag-chip) {
    min-block-size: 2rem;
    padding-inline: var(--space-3);
  }

  @media (max-width: 47.99rem) {
    :global(.popular-tags__inner) {
      display: block;
    }

    :global(.popular-tags__inner .section-heading) {
      margin-block-end: var(--space-5);
    }
  }
</style>

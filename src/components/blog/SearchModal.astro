<div class="search-modal" data-search-modal>
  <button class="search-modal__trigger" type="button" aria-label="検索を開く" data-search-trigger>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="11" cy="11" r="6.5"></circle>
      <path d="m16 16 4 4"></path>
    </svg>
    <span>検索</span>
  </button>

  <dialog class="search-dialog" aria-labelledby="search-dialog-title" data-search-dialog>
    <div class="search-dialog__panel">
      <div class="search-dialog__header">
        <div>
          <p class="search-dialog__eyebrow">SEARCH THE LOG</p>
          <h2 id="search-dialog-title">サイト内検索</h2>
        </div>
        <button class="search-dialog__close" type="button" aria-label="閉じる" data-search-close>
          <span aria-hidden="true">×</span>
        </button>
      </div>

      <form class="search-dialog__form" role="search" data-search-form>

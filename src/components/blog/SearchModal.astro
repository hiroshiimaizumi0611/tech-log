        <div class="search-dialog__field">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="m16 16 4 4"></path>
          </svg>
          <input id="site-search" type="search" name="q" autocomplete="off" placeholder="Astro、TypeScript、AWS…" data-search-input />
          <kbd aria-hidden="true">ESC</kbd>
        </div>
      </form>

      <p class="search-dialog__summary" aria-live="polite" data-search-summary>キーワードを入力してください</p>
      <div class="search-dialog__results" data-search-results></div>
    </div>
  </dialog>
</div>


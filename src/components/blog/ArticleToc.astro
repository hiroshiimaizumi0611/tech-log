---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
  variant: 'desktop' | 'mobile';
}
const { headings, variant } = Astro.props;
const links = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{
  variant === 'desktop' ? (
    <nav class="toc toc--desktop" aria-label="目次" data-desktop-toc>
      <p>CONTENTS</p>
      <ol>
        {links.map((heading) => (
          <li class:list={{ nested: heading.depth === 3 }}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  ) : (
    <details class="toc toc--mobile" data-mobile-toc>
      <summary>目次</summary>
      <nav aria-label="モバイル目次">
        <ol>
          {links.map((heading) => (
            <li class:list={{ nested: heading.depth === 3 }}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}

<style>
  .toc {
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 0.78rem;
  }
  .toc--desktop {
    position: sticky;
    top: var(--space-6);
    max-block-size: calc(100vh - var(--space-12));
    overflow-y: auto;
    padding-inline-start: var(--space-5);
    border-inline-start: 1px solid var(--color-border);
  }
  p {
    margin: 0 0 var(--space-4);
    color: var(--color-accent-soft);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.16em;
  }
  ol {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li.nested {
    padding-inline-start: var(--space-4);
  }
  a {
    text-decoration: none;
  }
  .toc--mobile {
    display: none;
    margin-block: var(--space-8);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }
  summary {
    cursor: pointer;
    color: var(--color-text);
    font-weight: 700;
  }
  .toc--mobile nav {
    margin-block-start: var(--space-4);
  }
  @media (max-width: 63.99rem) {
    .toc--desktop {
      display: none;
    }
    .toc--mobile {
      display: block;
    }
  }
</style>

---
interface Props {
  href: string;
  title: string;
}

const { href, title } = Astro.props;
---

<article class="featured" aria-label="注目記事">
  <a href={href}>
    <span class="eyebrow">FEATURED</span>
    <h2>{title}</h2>
    <span class="read-more">記事を読む <span aria-hidden="true">→</span></span>
  </a>
</article>

<style>
  .featured {
    min-inline-size: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-accent) 24%, var(--color-border));
    border-radius: var(--radius-card-lg);
    background: color-mix(in srgb, var(--color-card) 82%, transparent);
    box-shadow: 0 1.25rem 4rem color-mix(in srgb, var(--color-background) 62%, transparent);
    backdrop-filter: blur(1rem);
  }

  a {
    display: flex;
    min-block-size: 44px;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(var(--space-4), 2vw, var(--space-5));
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible {
    outline: 2px solid var(--color-accent-soft);
    outline-offset: -3px;
  }

  .eyebrow {
    padding: 0.12rem 0.45rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 65%, var(--color-border));
    border-radius: var(--radius-sm);
    color: var(--color-accent-soft);
    font-family: var(--font-ui);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
  }

  h2 {
    margin: var(--space-3) 0 0;
    font-family: var(--font-ui);
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    letter-spacing: -0.025em;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .read-more {
    margin-block-start: var(--space-3);
    color: var(--color-accent-soft);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .read-more > span {
    display: inline-block;
    transition: transform 160ms ease;
  }

  a:hover .read-more > span {
    transform: translateX(0.2rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .read-more > span {
      transition: none;
    }

    a:hover .read-more > span {
      transform: none;
    }
  }
</style>

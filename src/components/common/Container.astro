---
interface Props {
  as?: 'div' | 'section';
  class?: string;
}

const { as: Element = 'div', class: className }: Props = Astro.props;
---

<Element class:list={['container', className]}>
  <slot />
</Element>

<style>
  .container {
    inline-size: min(100%, calc(var(--container-max) + (2 * var(--container-gutter))));
    margin-inline: auto;
    padding-inline: var(--container-gutter);
  }
</style>

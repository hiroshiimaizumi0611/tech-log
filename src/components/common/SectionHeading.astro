---
interface Props {
  title: string;
  actionLabel?: string;
  actionHref?: string;
}

const { title, actionLabel, actionHref } = Astro.props;
---

<div class="section-heading">
  <h2>{title}</h2>
  {
    actionLabel && actionHref && (
      <a href={actionHref}>
        {actionLabel}
        <span aria-hidden="true">→</span>
      </a>
    )
  }
</div>

<style>
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-block-end: var(--space-5);
  }

  h2 {
    margin: 0;
    font-family: var(--font-ui);
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  h2::after {
    display: block;
    inline-size: 2rem;
    block-size: 2px;
    margin-block-start: var(--space-3);
    background: var(--color-accent);
    content: '';
  }

  a {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    color: var(--color-accent-soft);
    font-size: 0.875rem;
    font-weight: 650;
    text-decoration: none;
  }

  a:hover span {
    transform: translateX(0.2rem);
  }

  span {
    transition: transform var(--transition-fast);
  }

  @media (prefers-reduced-motion: reduce) {
    a:hover span {
      transform: none;
    }
  }
</style>

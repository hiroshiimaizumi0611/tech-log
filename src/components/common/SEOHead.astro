---
import { SITE } from '@/config/site';
import { buildJsonLd, buildSeo, serializeJsonLd } from '@/lib/seo';
import type { ImageMetadata } from 'astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: URL | string;
  pageType?: 'website' | 'article';
  ogImage?: string | ImageMetadata;
  heroImage?: string | ImageMetadata;
  publishedAt?: string;
  updatedAt?: string;
}

const {
  title = SITE.name,
  description = SITE.description,
  canonical,
  pageType = 'website',
  ogImage,
  heroImage,
  publishedAt,
  updatedAt,
} = Astro.props;
const input = {
  siteUrl: Astro.site ?? Astro.url.origin,
  pathname: Astro.url.pathname,
  title,
  description,
  canonical,
  pageType,
  ogImage,
  heroImage,
  publishedAt,
  updatedAt,
};
const seo = buildSeo(input);
const jsonLd = serializeJsonLd(buildJsonLd(input));
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
{googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
<link rel="canonical" href={seo.canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="ja_JP" />
<meta property="og:type" content={seo.ogType} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={seo.image} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={seo.image} />
{pageType === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt} />}
{pageType === 'article' && updatedAt && <meta property="article:modified_time" content={updatedAt} />}
<script is:inline type="application/ld+json" set:html={jsonLd} />
<title>{seo.title}</title>
